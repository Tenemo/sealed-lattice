{
    "compilerOptions": {
        "paths": {
            "#packages/*": ["./packages/*"],
            "#tests/*": ["./tests/*"],
            "#tools/*": ["./tools/*"]
        },
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2020", "ES2024.String", "DOM", "DOM.Iterable"],
        "removeComments": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "types": [],
        "strict": true,
        "sourceMap": true,
        "allowJs": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noUnusedParameters": true,
        "noUnusedLocals": true
    }
}
