{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": ["Cargo.lock", "Cargo.toml", "crates/**"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "check": {
            "dependsOn": ["^build", "^check"],
            "outputs": []
        }
    }
}
