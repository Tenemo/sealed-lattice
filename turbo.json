{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": [
        "Cargo.lock",
        "Cargo.toml",
        "crates/**",
        "tools/**"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "check": {
            "dependsOn": ["build", "^build", "^check"],
            "outputs": []
        }
    }
}
