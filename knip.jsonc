{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "workspaces": {
        ".": {
            "entry": [
                "tests/**/*.test.ts",
                // Browser entry bundled by the guarded preparation runner.
                "tools/ci/participant-preparation-storage.ts",
                // Workers the FHE key source screen starts by path.
                "tools/ci/fhe-key-source-browser-worker.mjs",
                "tools/ci/fhe-key-source-scalar-worker.mjs",
            ],
            "project": ["tests/**/*.{ts,mjs}", "tools/**/*.{ts,mjs}"],
        },
        "packages/sdk": {
            "entry": [
                "src/index.ts",
                "src/participant/worker/worker.ts",
                "tests/**/*.test.ts",
            ],
            "project": ["src/**/*.ts", "tests/**/*.ts"],
        },
    },
}
