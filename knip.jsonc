{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "workspaces": {
        ".": {
            "entry": [
                "tests/**/*.test.ts",
                "tools/ci/sdk-package-tsdown.config.ts",
                "tools/ci/resume-participant-release.ts",
            ],
            "project": ["tests/**/*.ts", "tools/**/*.ts"],
        },
        "packages/sdk": {
            "entry": [
                "src/index.ts",
                "src/participant/worker/worker.ts",
                "tests/**/*.test.ts",
            ],
            "project": ["src/**/*.ts", "tests/**/*.ts"],
        },
        "packages/wasm": {
            "entry": ["tests/**/*.test.ts"],
            "project": ["src/**/*.ts", "tests/**/*.ts"],
        },
    },
}
