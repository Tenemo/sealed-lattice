{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "workspaces": {
        ".": {
            "entry": [
                "tests/**/*.ts",
                "tools/ci/packed-package-smoke.mjs",
                "tools/ci/sdk-package-tsdown.config.ts",
            ],
            "project": ["tests/**/*.ts", "tools/**/*.ts", "tools/**/*.mjs"],
            "ignoreDependencies": [
                // The packed-package smoke script imports the tarball-installed SDK inside a temporary consumer.
                "sealed-lattice",
                // The Wasm kernel build resolves binaryen's wasm-opt script by path.
                "binaryen",
            ],
        },
        "packages/sdk": {
            "entry": ["tests/**/*.ts"],
            "project": ["src/**/*.ts", "tests/**/*.ts"],
            "ignoreDependencies": [
                // The public package intentionally declares the crypto backends used by the vendored runtime surface.
                "@noble/hashes",
                "@noble/post-quantum",
            ],
        },
        "packages/types": {
            "project": ["src/**/*.ts"],
        },
        "packages/protocol": {
            "entry": ["tests/**/*.ts"],
            "project": ["src/**/*.ts", "tests/**/*.ts"],
        },
        "packages/crypto": {
            "entry": ["tests/**/*.ts"],
            "project": ["src/**/*.ts", "tests/**/*.ts"],
        },
        "packages/wasm": {
            "entry": ["tests/**/*.ts"],
            "project": ["src/**/*.ts", "tests/**/*.ts"],
        },
    },
}
