{
    "name": "sealed-lattice-workspace",
    "version": "0.0.15",
    "private": true,
    "description": "Post-quantum threshold homomorphic voting library.",
    "author": "Piotr Piech <piotr@piech.dev>",
    "license": "MPL-2.0",
    "packageManager": "pnpm@10.33.0",
    "imports": {
        "#packages/*": "./packages/*",
        "#test-vectors/*": "./test-vectors/*",
        "#tests/*": "./tests/*",
        "#tools/*": "./tools/*"
    },
    "scripts": {
        "lint": "eslint . -c eslint.config.js --max-warnings 0",
        "eslint:fix": "eslint . --fix -c eslint.config.js --max-warnings 0",
        "tsc": "tsc --build --pretty false",
        "build": "turbo run build",
        "check": "tsx ./tools/ci/run-check.ts",
        "api-surface:generate": "pnpm run build && tsx ./tools/ci/generate-api-surface-summary.ts",
        "api-surface:update": "pnpm run api-surface:generate",
        "api-surface:check": "pnpm run api-surface:generate",
        "vectors": "tsx ./tools/ci/verify-test-vectors.ts",
        "vectors:generate": "tsx ./tools/ci/verify-test-vectors.ts --generate",
        "test:lattigo-oracle": "tsx ./tools/lattigo-oracle/verify-lattigo-oracle.ts",
        "test:node:fast": "tsx ./tools/ci/run-node-tests.ts --only fast",
        "test:node:protocol": "tsx ./tools/ci/run-node-tests.ts --only protocol",
        "test:node:kernel": "tsx ./tools/ci/run-node-tests.ts --only kernel",
        "test:node": "tsx ./tools/ci/run-node-tests.ts",
        "test:browser": "tsx ./tools/ci/run-browser-tests.ts",
        "test:proof-benchmark": "tsx ./tools/ci/run-proof-benchmarks.ts",
        "test:proof-benchmark:node": "tsx ./tools/ci/run-proof-benchmarks.ts --only node",
        "test:proof-benchmark:browser:desktop": "tsx ./tools/ci/run-proof-benchmarks.ts --only desktop",
        "test:aggregate-derivation-kernel": "tsx ./tools/ci/run-aggregate-derivation-kernel.ts",
        "test:encrypted-aggregate-evaluator:representative": "tsx ./tools/ci/run-encrypted-aggregate-evaluator-representative.ts",
        "test:encrypted-aggregate-bridge": "tsx ./tools/ci/run-encrypted-aggregate-bridge-matrix.ts",
        "test:encrypted-aggregate-bridge:representative": "tsx ./tools/ci/run-encrypted-aggregate-bridge-matrix.ts --representative",
        "test": "pnpm run test:node && pnpm run test:browser",
        "coverage:node": "pnpm run build && vitest --project node --run --coverage",
        "coverage:badge": "pnpm run coverage:node && tsx ./tools/ci/generate-coverage-badge.ts",
        "docs:api": "pnpm run build && pnpm exec del-cli docs/src/content/docs/api/reference && tsx ./node_modules/typedoc/bin/typedoc --options typedoc.config.mjs && tsx ./docs/typedoc/postprocess-site-docs.ts",
        "docs:dev": "pnpm run docs:api && astro dev --root docs",
        "docs:build": "pnpm run docs:api && pnpm exec del-cli docs/dist && astro build --root docs --silent",
        "docs:preview": "pnpm run docs:build && astro preview --root docs",
        "verify:docs": "pnpm run docs:build && tsx ./docs/typedoc/verify-docs.ts && tsx ./tools/ci/verify-docs-render.ts",
        "smoke:pack:npm": "pnpm --filter sealed-lattice run build && tsx ./tools/ci/verify-packed-package.ts --package-manager npm",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Tenemo/sealed-lattice.git"
    },
    "bugs": {
        "url": "https://github.com/Tenemo/sealed-lattice/issues"
    },
    "homepage": "https://tenemo.github.io/sealed-lattice/",
    "devDependencies": {
        "@astrojs/mdx": "^5.0.3",
        "@astrojs/starlight": "^0.38.3",
        "@eslint/js": "^10.0.1",
        "@fontsource/ibm-plex-sans": "^5.2.8",
        "@fontsource/jetbrains-mono": "^5.2.8",
        "@types/node": "^25.6.0",
        "@vitest/browser-playwright": "^4.1.4",
        "@vitest/coverage-v8": "^4.1.4",
        "@vitest/eslint-plugin": "^1.6.18",
        "astro": "^6.1.7",
        "binaryen": "^129.0.0",
        "del-cli": "^7.0.0",
        "eslint": "^10.2.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import-x": "^4.16.2",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.5.0",
        "husky": "^9.1.7",
        "knip": "^6.4.1",
        "log-update": "^8.0.0",
        "playwright": "^1.59.1",
        "prettier": "^3.8.3",
        "publint": "^0.3.21",
        "tsx": "^4.21.0",
        "turbo": "^2.5.5",
        "typedoc": "^0.28.19",
        "typedoc-plugin-frontmatter": "^1.3.1",
        "typedoc-plugin-markdown": "^4.11.0",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.60.0",
        "vite": "^8.0.8",
        "vitest": "^4.1.4"
    },
    "engines": {
        "node": ">=24.14.1"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "unrs-resolver"
        ]
    },
    "type": "module"
}
