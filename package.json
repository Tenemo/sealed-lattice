{
    "name": "sealed-lattice-workspace",
    "private": true,
    "description": "Browser-first, fixed-roster, private-score polling research library targeting post-quantum security.",
    "author": "Piotr Piech <piotr@piech.dev>",
    "license": "MPL-2.0",
    "packageManager": "pnpm@12.11.2",
    "imports": {
        "#packages/*": "./packages/*",
        "#tests/*": "./tests/*",
        "#tools/*": "./tools/*"
    },
    "scripts": {
        "lint": "eslint . --max-warnings 0 && prettier --check \"**/*.{json,jsonc,md,yml,yaml}\"",
        "lint:fix": "eslint . --fix --max-warnings 0 && prettier --write \"**/*.{json,jsonc,md,yml,yaml}\"",
        "tsc": "tsc --build --pretty false",
        "build": "pnpm --recursive run build",
        "build:verify-reproducible": "tsx ./tools/ci/verify-build-reproducibility.ts",
        "check": "tsx ./tools/ci/run-check.ts",
        "check:desktop": "tsx ./tools/ci/run-check.ts --include-desktop-browser",
        "research:protocol": "tsx ./tools/ci/run-protocol-research.ts",
        "research:protocol:public-records": "tsx ./tools/ci/run-protocol-public-records.ts",
        "research:participant": "pnpm run build && pnpm run research:participant:built",
        "research:participant:built": "tsx ./tools/ci/run-participant-browser.ts",
        "research:evidence-renewal": "tsx ./tools/ci/run-evidence-renewal.ts",
        "research:profiles": "tsx ./tools/ci/generate-supported-profile-table.ts",
        "docs:census": "tsx ./tools/ci/generate-documentation-census.ts",
        "docs:verify-sources": "tsx ./tools/ci/verify-source-manifest.ts",
        "release:version": "tsx ./tools/ci/release-version.ts",
        "test:rust:fast": "tsx ./tools/ci/run-rust-fast-tests.ts",
        "test:node:participant-module": "pnpm run build && pnpm run test:node:participant-module:built",
        "test:node:participant-module:built": "vitest --project node-participant-module --run",
        "test:node:built": "vitest --project node --project node-census --project node-participant-module --run",
        "test:browser:built": "vitest --project browser-desktop --run",
        "smoke:pack:npm:built": "tsx ./tools/ci/verify-packed-package.ts",
        "smoke:pack:npm": "pnpm run build && pnpm run smoke:pack:npm:built",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Tenemo/sealed-lattice.git"
    },
    "bugs": {
        "url": "https://github.com/Tenemo/sealed-lattice/issues"
    },
    "homepage": "https://github.com/Tenemo/sealed-lattice",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.19.2",
        "@vitest/browser-playwright": "^5.0.4",
        "@vitest/eslint-plugin": "^1.6.27",
        "binaryen": "^132.0.0",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "knip": "^6.41.0",
        "playwright": "^1.64.0",
        "prettier": "^3.9.10",
        "publint": "^0.3.25",
        "tsdown": "0.23.1",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.4",
        "yaml": "^2.9.1"
    },
    "engines": {
        "node": ">=24.17.0"
    },
    "type": "module"
}
