{
    "name": "sealed-lattice-workspace",
    "private": true,
    "description": "Browser-first post-quantum-oriented private-score polling research library.",
    "author": "Piotr Piech <piotr@piech.dev>",
    "license": "MPL-2.0",
    "packageManager": "pnpm@11.25.0",
    "imports": {
        "#packages/*": "./packages/*",
        "#tests/*": "./tests/*",
        "#tools/*": "./tools/*"
    },
    "scripts": {
        "lint": "eslint . --max-warnings 0",
        "eslint:fix": "eslint . --fix --max-warnings 0",
        "tsc": "tsc --build --pretty false",
        "build": "pnpm --recursive run build",
        "build:verify-reproducible": "tsx ./tools/ci/verify-build-reproducibility.ts",
        "check": "tsx ./tools/ci/run-check.ts",
        "check:desktop": "tsx ./tools/ci/run-check.ts --include-desktop-browser",
        "release:version": "tsx ./tools/ci/release-version.ts",
        "test:rust:kernel": "tsx ./tools/ci/run-rust-kernel-tests.ts",
        "test:node:kernel": "pnpm run build && pnpm exec vitest --project node-kernel-fast --run",
        "test:node:built": "vitest --project node --project node-kernel-fast --run",
        "test:node": "pnpm run build && pnpm run test:node:built",
        "test:browser:built": "vitest --project chromium-desktop --run",
        "test:browser": "pnpm run build && pnpm run test:browser:built",
        "test": "pnpm run build && pnpm run test:node:built && pnpm run test:browser:built",
        "smoke:pack:npm": "pnpm run build && tsx ./tools/ci/verify-packed-package.ts",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Tenemo/sealed-lattice.git"
    },
    "bugs": {
        "url": "https://github.com/Tenemo/sealed-lattice/issues"
    },
    "homepage": "https://github.com/Tenemo/sealed-lattice",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.3",
        "@vitest/browser-playwright": "^4.1.11",
        "@vitest/eslint-plugin": "^1.6.27",
        "binaryen": "^132.0.0",
        "del-cli": "^7.0.0",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "knip": "^6.34.0",
        "playwright": "^1.62.1",
        "prettier": "^3.9.6",
        "publint": "^0.3.24",
        "tsdown": "0.22.14",
        "tsx": "^4.23.13",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "engines": {
        "node": ">=24.14.1"
    },
    "type": "module"
}
