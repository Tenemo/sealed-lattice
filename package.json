{
    "name": "sealed-lattice-workspace",
    "version": "0.0.19",
    "private": true,
    "description": "Post-quantum threshold homomorphic voting library.",
    "author": "Piotr Piech <piotr@piech.dev>",
    "license": "MPL-2.0",
    "packageManager": "pnpm@10.33.0",
    "imports": {
        "#packages/*": "./packages/*",
        "#test-vectors/*": "./test-vectors/*",
        "#tests/*": "./tests/*",
        "#tools/*": "./tools/*"
    },
    "scripts": {
        "lint": "eslint . -c eslint.config.js --max-warnings 0",
        "eslint:fix": "eslint . --fix -c eslint.config.js --max-warnings 0",
        "tsc": "tsc --build --pretty false",
        "build": "turbo run build",
        "check": "tsx ./tools/ci/run-check.ts",
        "test:lanes:verify": "tsx ./tools/ci/verify-test-lane-coverage.ts",
        "api-surface:generate": "pnpm run build && tsx ./tools/ci/generate-api-surface-summary.ts",
        "test:lattigo-oracle": "tsx ./tools/lattigo-oracle/run-lattigo-oracle.ts",
        "test:rust:kernel": "tsx ./tools/ci/run-rust-kernel-tests.ts",
        "test:rust:kernel:heavy": "tsx ./tools/ci/run-rust-kernel-heavy-tests.ts",
        "test:rust:kernel:accepted-setup": "tsx ./tools/ci/run-rust-kernel-accepted-setup-tests.ts",
        "test:rust:kernel:full-profile-evidence": "tsx ./tools/ci/run-rust-kernel-manual-tests.ts rust-full-profile-evidence",
        "test:rust:kernel:measurements": "tsx ./tools/ci/run-rust-kernel-manual-tests.ts rust-measurements",
        "test:rust:process-memory-guard": "tsx ./tools/ci/run-process-memory-guard-tests.ts",
        "test:fuzz:foundation-schema-object": "tsx ./tools/ci/run-foundation-parser-fuzzing.ts",
        "test:node:fast": "tsx ./tools/ci/run-node-tests.ts fast",
        "test:node:protocol": "tsx ./tools/ci/run-node-tests.ts protocol",
        "test:node:kernel": "tsx ./tools/ci/run-node-tests.ts kernel",
        "test:node:kernel:fast": "tsx ./tools/ci/run-node-tests.ts kernel-fast",
        "test:node:kernel:heavy": "tsx ./tools/ci/run-node-tests.ts kernel-heavy",
        "test:node": "tsx ./tools/ci/run-node-tests.ts",
        "test:browser": "tsx ./tools/ci/run-browser-tests.ts",
        "test": "pnpm run test:node && pnpm run test:browser",
        "smoke:pack:npm": "pnpm --filter sealed-lattice run build && tsx ./tools/ci/verify-packed-package.ts",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Tenemo/sealed-lattice.git"
    },
    "bugs": {
        "url": "https://github.com/Tenemo/sealed-lattice/issues"
    },
    "homepage": "https://github.com/Tenemo/sealed-lattice",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.6.0",
        "@vitest/browser-playwright": "^4.1.4",
        "@vitest/eslint-plugin": "^1.6.18",
        "binaryen": "^129.0.0",
        "del-cli": "^7.0.0",
        "eslint": "^10.2.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import-x": "^4.16.2",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.5.0",
        "husky": "^9.1.7",
        "knip": "^6.4.1",
        "log-update": "^8.0.0",
        "playwright": "^1.59.1",
        "prettier": "^3.8.3",
        "publint": "^0.3.21",
        "tsx": "^4.21.0",
        "turbo": "^2.5.5",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.60.0",
        "vite": "^8.0.8",
        "vitest": "^4.1.4"
    },
    "engines": {
        "node": ">=24.14.1"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "unrs-resolver"
        ]
    },
    "type": "module"
}
