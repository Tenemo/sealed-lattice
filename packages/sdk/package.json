{
    "name": "sealed-lattice",
    "version": "0.0.16",
    "author": "Piotr Piech <piotr@piech.dev>",
    "license": "MPL-2.0",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Tenemo/sealed-lattice.git"
    },
    "bugs": {
        "url": "https://github.com/Tenemo/sealed-lattice/issues"
    },
    "homepage": "https://tenemo.github.io/sealed-lattice/",
    "engines": {
        "node": ">=24.14.1"
    },
    "scripts": {
        "check": "tsc --project tsconfig.json --pretty false --noEmit",
        "build:types": "pnpm --filter @sealed-lattice/types run build",
        "build:wasm": "tsx ../../tools/ci/build-wasm-kernel.ts --out packages/sdk/dist/sealed-lattice-kernel.wasm",
        "build:bridge": "tsx ../../tools/ci/build-sdk-bridge.ts",
        "build": "pnpm run build:types && del-cli dist tsconfig.tsbuildinfo && tsc --project tsconfig.json && pnpm run build:bridge && pnpm run build:wasm"
    },
    "devDependencies": {
        "@sealed-lattice/protocol": "workspace:*",
        "@sealed-lattice/types": "workspace:*",
        "@sealed-lattice/wasm": "workspace:*",
        "vitest": "^4.1.4"
    },
    "keywords": [
        "cryptography",
        "security",
        "post-quantum",
        "lattice",
        "threshold-encryption",
        "voting"
    ],
    "dependencies": {
        "@noble/hashes": "^2.2.0",
        "@noble/post-quantum": "0.6.1"
    }
}
