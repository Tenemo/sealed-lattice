{
    "name": "@sealed-lattice/wasm",
    "version": "0.0.0",
    "private": true,
    "description": "Internal WASM loader package for the sealed-lattice workspace.",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "dependencies": {
        "@sealed-lattice/types": "workspace:*"
    },
    "scripts": {
        "build:wasm": "tsx ../../tools/ci/build-wasm-kernel.ts",
        "build": "del-cli dist && tsc --project tsconfig.json && pnpm run build:wasm",
        "test:node:kernel:fast": "pnpm --workspace-root run test:node:kernel:fast",
        "test:node:kernel:heavy": "pnpm --workspace-root run test:node:kernel:heavy",
        "test:node:kernel": "pnpm --workspace-root run test:node:kernel",
        "test:node": "pnpm --workspace-root run test:node:kernel",
        "test:browser": "pnpm --workspace-root run test:browser"
    },
    "devDependencies": {
        "vitest": "^4.1.4"
    }
}
