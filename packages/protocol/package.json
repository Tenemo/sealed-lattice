{
  "name": "@sealed-lattice/protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Internal protocol package for deterministic election and transcript logic.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser-action-storage-custody": {
      "types": "./dist/runtime/browser-action-storage-custody.d.ts",
      "import": "./dist/runtime/browser-action-storage-custody.js"
    },
    "./browser-action-storage-worker-kernel": {
      "types": "./dist/runtime/browser-action-storage-custody-internal.d.ts",
      "import": "./dist/runtime/browser-action-storage-custody-internal.js"
    }
  },
  "imports": {
    "#packages/protocol/src/*.js": "./src/*.ts",
    "#packages/protocol/tests/*.js": "./tests/*.ts",
    "#packages/protocol/src/*": "./src/*.ts",
    "#packages/protocol/tests/*": "./tests/*.ts"
  },
  "scripts": {
    "check": "tsc --project tsconfig.json --pretty false --noEmit",
    "build": "del-cli dist && tsc --project tsconfig.json"
  },
  "dependencies": {
    "@sealed-lattice/crypto": "workspace:*",
    "@sealed-lattice/types": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.4"
  }
}
