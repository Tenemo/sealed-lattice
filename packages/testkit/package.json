{
    "name": "@sealed-lattice/testkit",
    "version": "0.0.0",
    "private": true,
    "description": "Internal deterministic test scaffolding package for the sealed-lattice workspace.",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
  "dependencies": {
    "@sealed-lattice/protocol": "workspace:*",
    "sealed-lattice": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.4"
  },
  "scripts": {
        "check": "tsc --project tsconfig.json --pretty false --noEmit",
        "build": "pnpm exec del-cli dist && tsc --project tsconfig.json"
    }
}
